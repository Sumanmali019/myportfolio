---
/**
 * The CV: the résumé (content/resume.ts, the same as public/resume.pdf) as semantic HTML in a
 * modal dialog — what "CV" and "Skip the animation · see my CV" open over the journey (Esc or
 * Close returns). Under it, folded away, the rest of the portfolio (about, apps, side builds).
 * It is also the page when JavaScript is off or a scene fails to load.
 */
import {
  formatDownloads,
  totalDownloads,
  type Link,
  type Profile,
  type SkillGroup,
} from '../content/schema';
import { resume } from '../content/resume';

interface Props {
  profile: Profile;
  skills: SkillGroup[];
  links: Record<string, Link>;
}

const { profile } = Astro.props;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
const newTab = '(opens in a new tab)';
const total = totalDownloads(profile.apps);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pdf = `${base}${profile.contact.resume}`;
---

<dialog class="skip cv" id="skip" aria-labelledby="skip-title" data-lenis-prevent>
  <div class="cv__bar">
    <a class="cv__download" href={pdf} download="Suman_Mali_Resume.pdf">
      <span aria-hidden="true">⤓</span> Download PDF
    </a>
    <button type="button" class="skip__close" id="skip-close"
      >Close <span aria-hidden="true">✕</span></button
    >
  </div>
  <article class="skip__inner cv__page">
    <header class="cv__head">
      <h1 id="skip-title">{resume.name}</h1>
      <p class="cv__contact">
        <a href={`tel:${resume.phone.replace(/[^+\d]/g, '')}`}>{resume.phone}</a>
        {
          resume.links.map((l) => (
            <>
              <span aria-hidden="true">|</span>
              <a href={l.href} {...ext}>
                {l.label}
                <span class="visually-hidden"> {newTab}</span>
              </a>
            </>
          ))
        }
        <span aria-hidden="true">|</span>
        <a href={`mailto:${resume.email}`}>{resume.email}</a>
      </p>
    </header>

    <section aria-labelledby="cv-skills">
      <h2 id="cv-skills">Skills</h2>
      <p class="cv__skills">{resume.skills.join(', ')}</p>
    </section>

    <section aria-labelledby="cv-exp">
      <h2 id="cv-exp">Experience</h2>
      {
        resume.experience.map((e) => (
          <div class="cv__item">
            <h3 class="cv__row">
              <span>{e.title}</span>
              <span class="cv__date">{e.period}</span>
            </h3>
            <p class="cv__org">{e.company}</p>
            <ul>
              {e.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="cv-projects">
      <h2 id="cv-projects">Projects</h2>
      {
        resume.projects.map((p) => (
          <div class="cv__item">
            <h3>{p.name}</h3>
            <p class="cv__link">
              <a href={p.link} {...ext}>
                {p.link}
                <span class="visually-hidden"> {newTab}</span>
              </a>
            </p>
            <p>
              <strong>Role:</strong> {p.role}
            </p>
            <p>
              <strong>Contributions &amp; Achievements:</strong>
            </p>
            <ul>
              {p.points.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="cv-achievements">
      <h2 id="cv-achievements">Achievements</h2>
      <ul>
        {
          resume.achievements.map((a) => (
            <li>
              <strong>{a.label}</strong>
              <br />
              <a href={a.href} {...ext}>
                {a.href}
                <span class="visually-hidden"> {newTab}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="cv-edu">
      <h2 id="cv-edu">Education</h2>
      {
        resume.education.map((e) => (
          <div class="cv__item">
            <h3 class="cv__row">
              <span>{e.school}</span>
              <span class="cv__date">{e.year}</span>
            </h3>
            <p>{e.degree}</p>
          </div>
        ))
      }
    </section>

    <details class="cv__more">
      <summary>More from the journey: about, apps and side builds</summary>
      <section aria-labelledby="skip-about">
        <h2 id="skip-about">About</h2>
        <p>{profile.about}</p>
      </section>
      <section aria-labelledby="skip-apps">
        <h2 id="skip-apps">Apps along the way</h2>
        <p class="muted">
          {formatDownloads(total)} downloads across the apps with published figures.
        </p>
        <ul>
          {
            profile.apps.map((a) => (
              <li>
                <strong>{a.name}</strong> ({a.company}
                {a.role ? `, ${a.role}` : ''}) — {a.summary}
                {a.badge && <span class="badge">{a.badge}</span>}
              </li>
            ))
          }
        </ul>
      </section>
      <section aria-labelledby="skip-projects">
        <h2 id="skip-projects">Projects and side builds</h2>
        <ul>
          {
            profile.projects.map((p) => (
              <li>
                <a href={p.url} {...ext}>
                  {p.name}
                  <span class="visually-hidden"> {newTab}</span>
                </a>{' '}
                — {p.summary}
              </li>
            ))
          }
        </ul>
      </section>
      <section aria-labelledby="skip-more-edu">
        <h2 id="skip-more-edu">Learning</h2>
        <ul>
          {
            profile.education.map((e) => (
              <li>
                <strong>{e.school}</strong> — {e.course}, {e.period}
              </li>
            ))
          }
        </ul>
      </section>
    </details>
  </article>
</dialog>
