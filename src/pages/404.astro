---
/** A tiny illustrated "wrong gate" page. No JavaScript. */
import '@fontsource/dm-mono/400.css';
import '@fontsource/special-elite/400.css';
import '../styles/tokens.css';
import SeoHead from '../components/SeoHead.astro';
import { loadContent } from '../content/schema';

const { profile } = loadContent();
---

<!doctype html>
<html lang="en-IN">
  <head>
    <SeoHead
      title={`Wrong gate — ${profile.name}`}
      description="This page took a different flight."
      profile={profile}
      noindex
    />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #2f2c57;
        color: #fbf6ee;
        font-family: var(--font-ui);
        text-align: center;
        padding: 16px;
      }
      h1 {
        font-family: var(--font-title);
        font-weight: 400;
        font-size: clamp(2rem, 6vw, 3.4rem);
        margin: 1rem 0 0.25rem;
      }
      p {
        margin: 0 0 1.5rem;
        color: #d9d3ea;
      }
      a {
        display: inline-block;
        padding: 0.6rem 1.2rem;
        border-radius: 999px;
        background: #fbf6ee;
        color: #2a2438;
        text-decoration: none;
        font-weight: 500;
      }
      a:focus-visible {
        outline: 3px solid #f2b84b;
        outline-offset: 3px;
      }
      svg {
        width: min(320px, 80vw);
        height: auto;
        margin: 0 auto;
      }
    </style>
  </head>
  <body>
    <main>
      <svg viewBox="0 0 320 220" aria-hidden="true">
        <rect x="0" y="180" width="320" height="40" fill="#3a3560"></rect>
        <rect x="30" y="20" width="260" height="70" rx="10" fill="#14172a"></rect>
        <text x="50" y="50" font-size="16" fill="#a3a9c2" font-family="DM Mono, monospace"
          >GATE</text
        >
        <text x="50" y="76" font-size="22" fill="#f2b84b" font-family="DM Mono, monospace"
          >4 0 4</text
        >
        <text
          x="270"
          y="76"
          font-size="14"
          fill="#ef6a5f"
          text-anchor="end"
          font-family="DM Mono, monospace">CLOSED</text
        >
        <rect x="120" y="100" width="80" height="80" rx="6" fill="#c8674a"></rect>
        <rect x="146" y="88" width="28" height="14" rx="4" fill="#3b3550"></rect>
        <circle cx="132" cy="182" r="5" fill="#2a2438"></circle>
        <circle cx="188" cy="182" r="5" fill="#2a2438"></circle>
      </svg>
      <h1>Wrong gate.</h1>
      <p>This page took a different flight.</p>
      <a href="/">Back to the journey</a>
    </main>
  </body>
</html>
