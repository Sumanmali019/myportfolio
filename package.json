{
  "name": "suman-day-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "A day in my life — Suman Mali. A scroll-driven illustrated portfolio.",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-budgets.mjs",
    "preview": "astro preview --port 4321",
    "lint": "eslint . --ext .ts,.astro,.mjs,.cjs && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "cross-env VISUAL=1 playwright test tests/e2e/visual.spec.ts",
    "svg:optimize": "node scripts/optimize-svg.mjs",
    "art": "node --experimental-strip-types --no-warnings scripts/art/generate-scenes.mjs",
    "og": "node scripts/render-og.mjs",
    "budgets": "node scripts/check-budgets.mjs",
    "lhci": "lhci autorun",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,astro,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write",
    "src/assets/scenes/**/*.svg": "node scripts/optimize-svg.mjs"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.1.0",
    "@fontsource/special-elite": "^5.1.0",
    "lenis": "^1.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.2.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "astro": "^5.1.0",
    "astro-eslint-parser": "^1.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-astro": "^1.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "svgo": "^3.3.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
